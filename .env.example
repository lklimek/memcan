# MemCan Environment Configuration
#
# Legend:  [REQUIRED] — must be set for secure operation
#          [optional] — has a sensible default, uncomment to override

# --- MemCan Server ---

# [REQUIRED] Bearer token auth for MCP API. Without this, the API is unauthenticated.
MEMCAN_API_KEY=your-secret-key

# [optional] Server bind address (default: 127.0.0.1:8191, Docker overrides to 0.0.0.0:8191)
# MEMCAN_LISTEN=127.0.0.1:8191

# [optional] Server URL for thin clients (memcan CLI)
# MEMCAN_URL=http://localhost:8190

# [optional] Log file path. Omit to use the default file; set empty ("") to log to stdout/stderr.
# MEMCAN_LOG_FILE=""

# --- Ollama ---
# Only needed when DISTILL_MEMORIES=true (default). Skip this section if running without LLM.

# [optional] Ollama server URL for LLM inference
# Default: http://ollama:11434 (bundled container) or http://localhost:11434 (standalone)
# OLLAMA_HOST=http://localhost:11434

# [optional] Bearer token for Ollama endpoint auth (e.g. behind a reverse proxy)
# OLLAMA_API_KEY=your-token-here

# [optional] Primary and fallback LLM backends: ollama or openrouter
# LLM_PROVIDER=ollama
# LLM_FALLBACK_PROVIDER=openrouter

# [required when OpenRouter participates] OpenRouter bearer key and model slug
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# [optional] OpenRouter-compatible API endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Storage ---

# [optional] LanceDB storage path (embedded — no server needed)
# LANCEDB_PATH=~/.local/share/memcan/lancedb

# [optional] Default user ID for memory scoping
# DEFAULT_USER_ID=global

# --- LLM & Embeddings ---

# [optional] Memory distillation (LLM fact extraction + dedup)
# Set to false to run without Ollama — stores memories as-is
# DISTILL_MEMORIES=true

# [optional] LLM model name (default: gemma4:26b-a4b-it-qat — needs ~16GB VRAM;
# use qwen3.5:9b instead if your GPU has less, e.g. 8GB)
# LLM_MODEL=gemma4:26b-a4b-it-qat

# [optional] Embedding model — fastembed in-process ONNX model name
# EMBED_MODEL=MultilingualE5Large

# --- Traefik / Networking (Docker only) ---

# [optional] IP allowlist for Traefik middlewares (applies to memcan, ollama, webui)
# Default: localhost only (IPv4 + IPv6). Add your network CIDR to allow remote access.
# TRAEFIK_IP_ALLOWLIST=127.0.0.1/32,::1/128

# --- Docker Compose ---

# [optional] Profiles to enable. "ollama" starts the bundled Ollama container.
# "ollama,webui" also starts Open WebUI. Leave empty to use an external Ollama.
# COMPOSE_PROFILES=ollama

# [optional] Rust log level for memcan container
# RUST_LOG=info,memcan_core=debug,memcan_server=debug

# [optional] Host path for Ollama model storage (default: Docker named volume)
# OLLAMA_DATA_DIR=ollama-data
